# Copy to .env and fill in. Only CLAUDE_API_KEY is strictly required.

# --- Claude (required): Director / Composer / critics / verifier + the coding agent
CLAUDE_API_KEY=sk-ant-...
# Optional: an Anthropic-compatible proxy. Leave empty for api.anthropic.com.
CLAUDE_BASE_URL=

# --- Reference images for asset generation (optional; see README "Reference images")
# Option A: Gemini image model (fastest, best quality).
GEMINI_API_KEY=
# Use the official endpoint, or an OpenAI-compatible proxy that serves Gemini image models.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Option B: any OpenAI-compatible endpoint that returns images from chat completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Option C needs no key: local Z-Image-Turbo (set REF_IMAGE_PROVIDERS=local in config.sh).
