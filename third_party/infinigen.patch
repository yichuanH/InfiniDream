+def _overexposed_ratio(image_path: Path) -> float:
+    """Return fraction of non-transparent pixels where all RGB channels >= 250."""
+    img = Image.open(image_path).convert("RGBA")
+    arr = np.array(img, dtype=np.float32)
+    alpha_mask = arr[:, :, 3] > 10
+    if alpha_mask.sum() == 0:
+        return 0.0
+    rgb = arr[:, :, :3][alpha_mask]
+    return float((rgb >= 250).all(axis=1).sum()) / len(rgb)
+
+
+def _auto_adjust_exposure(image_path: Path, scene, step: float = 0.5,
+                          threshold: float = 0.40, max_retries: int = 3):
+    """After a render, lower exposure and re-render if overexposed. Saves final value to exposure.txt."""
+    for attempt in range(max_retries):
+        ratio = _overexposed_ratio(image_path)
+        print(f"[exposure] Overexposed pixels: {ratio:.1%} (threshold {threshold:.0%})")
+        if ratio <= threshold:
+            break
+        new_exp = scene.view_settings.exposure - step
+        print(f"[exposure] Too bright — lowering exposure {scene.view_settings.exposure:.2f} → {new_exp:.2f}")
+        scene.view_settings.exposure = new_exp
+        bpy.ops.render.render(write_still=True)
+    else:
+        print(f"[exposure] Max retries reached, keeping current exposure {scene.view_settings.exposure:.2f}")
+    final_exp = scene.view_settings.exposure
+    (image_path.parent / "exposure.txt").write_text(f"{final_exp:.4f}\n")
+    print(f"[exposure] Final exposure: {final_exp:.2f} → saved to exposure.txt")
+
